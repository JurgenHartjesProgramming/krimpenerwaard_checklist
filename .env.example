# Every variable is explained in docs/SETUP.md. Validate with: npm run check-env

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://checklist:checklist@localhost:5435/checklist

# Auth.js session secret (min. 32 chars) — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Entra ID app registration (multitenant). Leave both empty to use only the development login.
# Redirect URI: <AUTH_URL>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
# The secret's "Value", not its "Secret ID".
AUTH_MICROSOFT_ENTRA_ID_SECRET=

# Comma separated tenant IDs (GUIDs, not domains) that may sign in.
# Production: only the Krimpenerwaard tenant. Test: add your own tenant ID.
ALLOWED_TENANT_IDS=

# Work/school e-mail that becomes an active admin on its first Microsoft sign-in.
INITIAL_ADMIN_EMAIL=
